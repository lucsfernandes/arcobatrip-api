# Porta da aplicação
PORT=3000

# Configurações do banco de dados PostgreSQL
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=sua_senha
TYPEORM_DATABASE=zarpa
TYPEORM_SYNC=false

API_BASE_URL=
WEB_BASE_URL=

# CORS — origens permitidas, separadas por vírgula (sem espaços obrigatórios).
# Ex.: CORS_ORIGINS=https://app.zarpa.com,https://admin.zarpa.com
# Deixe VAZIO em desenvolvimento: nesse modo qualquer origem localhost/127.0.0.1
# (qualquer porta — Vite, Expo, etc.) é aceita automaticamente. Origens externas
# NUNCA são refletidas quando a lista está vazia.
CORS_ORIGINS=

# Segredos JWT — OBRIGATÓRIOS, mínimo 32 caracteres cada, SEM valor padrão.
# A aplicação FALHA ao subir se não estiverem definidos ou forem curtos.
# Gere valores fortes e distintos, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NUNCA reutilize o mesmo valor entre JWT_SECRET e JWT_REFRESH_SECRET.
JWT_SECRET=
# JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
# JWT_REFRESH_EXPIRES_IN=7d

# Envio de emails transacionais (Resend - https://resend.com)
# Deixe RESEND_API_KEY vazio para desabilitar o envio (a aplicação apenas loga um aviso).
RESEND_API_KEY=
# EMAIL_FROM=Zarpa <no-reply@zarpa.com>

# URL base do frontend, usada para montar os links de reset/confirmação de email
# APP_URL=http://localhost:5173

# Tempo de vida (em minutos) dos tokens enviados por email
# EMAIL_VERIFICATION_TOKEN_TTL_MIN=1440
# PASSWORD_RESET_TOKEN_TTL_MIN=60

# Verificação de celular por email (código numérico de 6 dígitos)
# PHONE_VERIFICATION_CODE_TTL_MIN=15
# PHONE_VERIFICATION_RESEND_COOLDOWN_SEC=60
# PHONE_VERIFICATION_MAX_ATTEMPTS=5
# Segredo HMAC do hash do código de celular (mínimo 16 caracteres). OPCIONAL:
# se vazio, deriva-se de JWT_SECRET automaticamente. Defina em produção para
# desacoplar do segredo JWT. Ex.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# PHONE_CODE_SECRET=

# Cloudinary (upload de avatar - https://cloudinary.com)
# Deixe vazio para desabilitar o upload em desenvolvimento.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=