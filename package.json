{
  "name": "zarpa",
  "version": "1.0.0",
  "description": "This is Zarpa API",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main/server.js",
    "dev": "tsx watch --clear-screen=true src/main/server.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create ./src/infra/db/migrations/migration",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate --dataSource ./src/infra/db/ormconfig.ts src/infra/db/migrations/migration",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run --dataSource ./src/infra/db/ormconfig.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucsfernandes/zarpa-api.git"
  },
  "keywords": [
    "arcobatrox;",
    "zarpa;",
    "trip;",
    "travel;"
  ],
  "author": "Lucas Fernandes",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lucsfernandes/zarpa-api/issues"
  },
  "homepage": "https://github.com/lucsfernandes/zarpa-api#readme",
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^11.3.3",
    "file-type": "^16.5.4",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.2",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/dotenv-safe": "^8.1.6",
    "@types/express": "^5.0.0",
    "@types/express-actuator": "^1.8.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/yamljs": "^0.2.34",
    "jest": "^30.5.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@react-email/render": "$@react-email/render",
    "glob@^10.0.0 || ^13.0.0": "^14.0.3",
    "minimatch@^9.0.0 || ^10.0.0": "^11.0.4"
  }
}
